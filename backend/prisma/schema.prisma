// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ConversationTree {
  id          String   @id @default(uuid())
  rootNodeId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  nodes             ConversationNode[]
  connectionLabels  ConnectionLabel[]
  canvasState       CanvasState?

  @@map("conversation_trees")
}

model ConversationNode {
  id                      String   @id @default(uuid())
  title                   String   @default("New Conversation")
  parentId                String?
  branchSourceMessageId   String?
  branchSelectedText      String?
  summary                 String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  treeId                  String
  tree                    ConversationTree @relation(fields: [treeId], references: [id], onDelete: Cascade)

  parent                  ConversationNode?  @relation("ConversationHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children                ConversationNode[] @relation("ConversationHierarchy")

  messages                Message[]

  @@index([treeId])
  @@index([parentId])
  @@map("conversation_nodes")
}

model Message {
  id                String   @id @default(uuid())
  role              String   // 'user' or 'assistant'
  content           String
  timestamp         DateTime @default(now())

  conversationId    String
  conversation      ConversationNode @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

model ConnectionLabel {
  id            String   @id @default(uuid())
  connectionId  String   @unique // Format: "parentId-childId"
  treeId        String
  type          String   // 'deepens', 'explores', 'contrasts', 'examples', 'applies', 'questions', 'extends', 'summarizes', 'custom'
  text          String   // Display label
  aiGenerated   Boolean  @default(true)
  userEdited    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tree          ConversationTree @relation(fields: [treeId], references: [id], onDelete: Cascade)

  @@index([treeId])
  @@index([connectionId])
  @@map("connection_labels")
}

model CanvasState {
  id                    String   @id @default(uuid())
  treeId                String   @unique
  userAnnotations       Json     // User-created Excalidraw elements
  nodePositionOverrides Json     // Custom node positions
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tree                  ConversationTree @relation(fields: [treeId], references: [id], onDelete: Cascade)

  @@map("canvas_states")
}
